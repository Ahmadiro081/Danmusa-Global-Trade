# ==============================================================================
# Danmusa Global Trade (DGT) — Environment Configuration Template
# Copy this file to .env for local development. NEVER commit real secrets.
# ==============================================================================

# Application Runtime
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Supabase (Database & Authentication)
# Public client variables (safe for browser bundle)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only Supabase credentials (NEVER expose to frontend)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudinary (Product Photography & Customer Sourcing Image Uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Online Payment Gateway (Paystack — Deferred for future phase)
# Bank transfer with manual administrator verification is the initial active payment workflow.
# PAYSTACK_PUBLIC_KEY=""
# PAYSTACK_SECRET_KEY=""

# Resend (Transactional Email Notifications)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# WhatsApp Business API (Order & Sourcing Updates)
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# AI Studio Runtime Defaults (Injected by platform if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
